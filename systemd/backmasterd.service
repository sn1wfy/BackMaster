[Unit]
Description=BackMaster intrusion prevention service
Documentation=file:/usr/local/share/doc/backmaster/README.md
After=network-pre.target
Wants=network-pre.target
Before=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/backmasterd --config /etc/backmaster/backmaster.conf --journal
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

# The daemon needs raw netlink, netfilter control and the ability to read every
# process, so it runs as root. These limits remove what it does not need.
NoNewPrivileges=yes
ProtectHome=read-only
ProtectHostname=yes
ProtectKernelImage=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes

# nft is invoked as a child process, so the filesystem cannot be fully sealed,
# but the writable set is small.
ProtectSystem=full
ReadWritePaths=/var/lib/backmaster /etc/backmaster/blocklists /run

CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_SYSLOG CAP_KILL
AmbientCapabilities=

RuntimeDirectory=backmaster
RuntimeDirectoryMode=0755
StateDirectory=backmaster
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
